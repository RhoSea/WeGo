# Copy to .env and fill in with values from your Supabase project:
# Supabase dashboard -> Project Settings -> API
#
# Both values are safe to expose in a browser bundle. The anon key only ever
# grants what Row Level Security allows.
# NEVER put the service_role key in this file or anywhere in the repo.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base path used by Vite when building for GitHub Pages.
# For https://<user>.github.io/wego/ this must be "/wego/".
# Leave unset for local development.
# VITE_BASE_PATH=/wego/
