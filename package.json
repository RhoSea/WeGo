    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "@types/node": "^24.0.0",
    "vite-node": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
